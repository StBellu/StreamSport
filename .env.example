# StreamSport Environment Configuration Template
APP_ENV=production
HOST=0.0.0.0
PORT=7860
LOG_LEVEL=INFO
TIMEZONE=Europe/Rome

# Background Sync & Cache Intervals (seconds)
SYNC_INTERVAL_SECONDS=3600
SYNC_INTERVAL_SECONDS_NIGHT=14400
EPG_SYNC_INTERVAL_SECONDS=7200
THESPORTSDB_SYNC_INTERVAL_SECONDS=43200
MATCH_RETENTION_HOURS=6

# ==============================================================================
# Individual Data Source & Provider Toggles (true / false)
# ==============================================================================
ENABLE_DIRETTA=true
ENABLE_SKY_EPG=true
ENABLE_THESPORTSDB=true
ENABLE_TENNIS_POSTERS=true
ENABLE_TVVOO=true
ENABLE_MANDRAKODI=true
ENABLE_SPON=true
ENABLE_DADDYLIVE=true
ENABLE_STREAMFREE=true
ENABLE_FCTV33=true

# ==============================================================================
# Credentials & API Secrets (set in .env or Docker Compose)
# ==============================================================================
THESPORTSDB_USER=
THESPORTSDB_PASS=
MANDRAKODI_PASSWORD=
MANDRAKODI_DEVICE_ID=
MANDRAKODI_API_URL=
MANDRAKODI_XOR_KEY=my_secret_key
FLASHSCORE_FSIGN=SW9D1eZo

# Provider Endpoints & Cache Settings
STREAMFREE_DIRECTORY_URL=https://strmfree.link/api/domains
STREAMFREE_PRIMARY_MIRROR=strmfree.pk
STREAMFREE_FALLBACK_MIRRORS=strmfree.st,streamfree.top
FCTV33_API_BASE=https://apis-data10.tcpwe138stya.ru
SPON_PRIMARY_URL=https://sportsonline.st/prog.txt
SPON_FALLBACK_URL=https://sportsonline.cx/prog.txt
SPON_CACHE_TTL=7200

# Default EasyProxy Configuration (optional fallback if user config omits them)
DEFAULT_EP_URL=
DEFAULT_EP_PASS=
PUBLIC_URL=

# ==============================================================================
# Modular Outbound Proxy Routing (HTTP / HTTPS / SOCKS5 / SOCKS5H)
# - Leave blank to inherit GLOBAL_PROXY (e.g. socks5h://warp:1080)
# - Set "direct" on any service override to bypass GLOBAL_PROXY
# ==============================================================================
GLOBAL_PROXY=
DIRETTA_PROXY=
SKY_EPG_PROXY=
THESPORTSDB_PROXY=
TENNIS_POSTERS_PROXY=
TVVOO_PROXY=
MANDRAKODI_PROXY=
SPON_PROXY=
DADDYLIVE_PROXY=
STREAMFREE_PROXY=
FCTV33_PROXY=

# Optional Cloudflare WARP sidecar settings (used by docker-compose.yml `warp` service)
WARP_SLEEP=2
WARP_LICENSE_KEY=
